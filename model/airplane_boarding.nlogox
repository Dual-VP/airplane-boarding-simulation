<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[__includes [ "environment.nls" "passengers.nls" "strategies.nls" ]

extensions [ csv ]

;; ------------------------------------------------------------------------------
;; Variables globales
;; ------------------------------------------------------------------------------
globals [
  ;; Les variables d'interface sont automatiquement créées par leurs widgets :
  ;; aircraft-type, boarding-strategy, occupancy-rate, luggage-percentage,
  ;; min-luggage-delay, max-luggage-delay, show-seat-labels?

  ;; Métriques & géométrie de l'environnement
  total-seats                ;; Nombre total de sièges détectés dans la cabine
  cabin-length               ;; Longueur en rangées physiques (axe Y)
  cabin-width                ;; Largeur en colonnes physiques (axe X)
  door-patch                 ;; Patch représentant la porte d'embarquement
  total-seat-rows            ;; Nombre de rangées commerciales distinctes

  ;; File d'attente & dynamique d'embarquement
  boarding-queue             ;; Liste ordonnée des agents passagers en attente d'entrer
  total-interference-ticks   ;; Cumul des secondes passées bloqué dans l'allée
  boarding-completed?        ;; Booléen : vrai quand tous les passagers sont assis
]

;; ------------------------------------------------------------------------------
;; Propriétés des patchs (cellules de la cabine)
;; ------------------------------------------------------------------------------
patches-own [
  patch-type                 ;; "wall", "aisle", "seat", "door"
  seat-id                    ;; Identifiant commercial du siège (ex: "12A"), "" si non-siège
  seat-row                   ;; Numéro de rangée commerciale (ex: 12), 0 si non-siège
  seat-letter                ;; Lettre du siège ("A" à "F"), "" si non-siège
  is-exit-row?               ;; Booléen : vrai pour les issues de secours
  is-business?               ;; Booléen : vrai pour les sièges Business (B737 rangées 1-3)
  occupied?                  ;; Booléen : vrai si un passager est assis ou présent
]

;; ==============================================================================
;; Procédure principale de configuration (Setup)
;; ==============================================================================
to setup
  ;; Conserver les choix de widgets avant clear-all (pour exécution headless & BehaviorSpace)
  let chosen-aircraft aircraft-type
  let chosen-strategy boarding-strategy
  let chosen-occupancy occupancy-rate
  let chosen-luggage luggage-percentage
  let chosen-min-delay min-luggage-delay
  let chosen-max-delay max-luggage-delay
  let chosen-labels show-seat-labels?

  clear-all

  ;; Rétablir ou initialiser par défaut
  ifelse chosen-aircraft != 0 and chosen-aircraft != "" [ set aircraft-type chosen-aircraft ] [ set aircraft-type "A320" ]
  ifelse chosen-strategy != 0 and chosen-strategy != "" [ set boarding-strategy chosen-strategy ] [ set boarding-strategy "random" ]
  ifelse chosen-occupancy != 0 [ set occupancy-rate chosen-occupancy ] [ set occupancy-rate 100 ]
  ifelse chosen-luggage != 0 [ set luggage-percentage chosen-luggage ] [ set luggage-percentage 80 ]
  ifelse chosen-min-delay != 0 [ set min-luggage-delay chosen-min-delay ] [ set min-luggage-delay 5 ]
  ifelse chosen-max-delay != 0 [ set max-luggage-delay chosen-max-delay ] [ set max-luggage-delay 15 ]
  ifelse is-boolean? chosen-labels [ set show-seat-labels? chosen-labels ] [ set show-seat-labels? true ]

  set total-interference-ticks 0
  set boarding-completed? false

  ;; 1. Charger la cabine de l'avion sélectionné
  load-aircraft-environment aircraft-type

  ;; 2. Mettre à jour l'affichage graphique de la cabine
  update-visuals

  ;; 3. Générer et ordonnancer les agents passagers selon la stratégie choisie
  setup-passengers

  ;; 4. Initialiser le compteur temporel
  reset-ticks

  ;; 5. Bilan console
  print-cabin-summary
  print-passengers-summary
end

;; ==============================================================================
;; Procédure principale d'exécution (Go - 1 seconde / 1 tick)
;; ==============================================================================
to go
  ;; Arrêt automatique si l'embarquement est terminé
  if boarding-completed? [
    stop
  ]

  ;; 1. Mettre à jour les passagers déjà à l'intérieur de l'avion
  update-passengers

  ;; 2. Faire entrer le passager suivant si la porte est libre
  spawn-next-passenger-from-queue

  ;; 3. Vérifier si tous les passagers sont assis
  check-boarding-completion

  ;; 4. Avancer le temps de simulation
  tick
end
]]></code>
  <widgets>
    <view x="205" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="0" height="640" showTickCounter="true" patchSize="15.0" fontSize="10" wrappingAllowedY="false" width="180" tickCounterLabel="ticks (secondes)" maxPycor="34" updateMode="1" maxPxcor="8" minPxcor="0"></view>
    <button x="10" y="10" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="180" display="Setup Simulation">setup</button>
    <button x="10" y="50" height="35" disableUntilTicks="true" forever="true" kind="Observer" width="90" display="Embarquer">go</button>
    <button x="105" y="50" height="35" disableUntilTicks="true" forever="false" kind="Observer" width="85" display="1 Pas">go</button>
    <chooser x="10" y="95" height="45" variable="aircraft-type" current="0" width="180" display="Modèle d'avion">
      <choice type="string" value="A320"></choice>
      <choice type="string" value="B737"></choice>
    </chooser>
    <chooser x="10" y="145" height="45" variable="boarding-strategy" current="0" width="180" display="Stratégie d'embarquement">
      <choice type="string" value="random"></choice>
      <choice type="string" value="front-to-back"></choice>
      <choice type="string" value="back-to-front"></choice>
      <choice type="string" value="wilma"></choice>
    </chooser>
    <slider x="10" step="5" y="195" max="100" width="180" display="Taux de remplissage" height="45" min="10" direction="Horizontal" default="100.0" variable="occupancy-rate" units="%"></slider>
    <slider x="10" step="5" y="245" max="100" width="180" display="Passagers avec bagage" height="45" min="0" direction="Horizontal" default="80.0" variable="luggage-percentage" units="%"></slider>
    <slider x="10" step="1" y="295" max="30" width="180" display="Rangement min" height="45" min="1" direction="Horizontal" default="5.0" variable="min-luggage-delay" units="s"></slider>
    <slider x="10" step="1" y="345" max="30" width="180" display="Rangement max" height="45" min="1" direction="Horizontal" default="15.0" variable="max-luggage-delay" units="s"></slider>
    <switch x="10" y="395" height="35" on="true" variable="show-seat-labels?" width="180" display="Afficher étiquettes"></switch>
    <button x="10" y="435" height="30" disableUntilTicks="false" forever="false" kind="Observer" width="180" display="Basculer étiquettes">toggle-labels</button>
    <monitor x="400" precision="0" y="10" height="45" fontSize="11" width="140" display="Temps écoulé (s)">ticks</monitor>
    <monitor x="545" precision="0" y="10" height="45" fontSize="11" width="140" display="Progression (%)">boarding-progress-percent</monitor>
    <monitor x="400" precision="0" y="60" height="45" fontSize="11" width="140" display="Passagers assis">passengers-seated-count</monitor>
    <monitor x="545" precision="0" y="60" height="45" fontSize="11" width="140" display="En file d'attente">passengers-waiting-count</monitor>
    <monitor x="400" precision="0" y="110" height="45" fontSize="11" width="140" display="Dans l'allée">passengers-in-plane-count</monitor>
    <monitor x="545" precision="0" y="110" height="45" fontSize="11" width="140" display="En rangement">passengers-stowing-count</monitor>
    <monitor x="400" precision="0" y="160" height="45" fontSize="11" width="140" display="Interférences (s)">total-interference-ticks</monitor>
    <monitor x="545" precision="1" y="160" height="45" fontSize="11" width="140" display="Attente moy (s)">mean-passenger-wait-time</monitor>
    <monitor x="400" precision="0" y="210" height="45" fontSize="11" width="140" display="Total Sièges">total-seats</monitor>
    <monitor x="545" precision="0" y="210" height="45" fontSize="11" width="140" display="Rangées Sièges">total-seat-rows</monitor>
    <plot x="400" autoPlotX="true" yMax="180.0" autoPlotY="true" yAxis="Passagers" y="265" xMin="0.0" height="195" legend="false" xMax="600.0" yMin="0.0" width="285" xAxis="Temps (s)" display="Dynamique d'embarquement">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Assis" color="-13345367" legend="true">
        <setup></setup>
        <update>plot passengers-seated-count</update>
      </pen>
      <pen interval="1.0" mode="0" display="En attente" color="-267413" legend="true">
        <setup></setup>
        <update>plot passengers-waiting-count</update>
      </pen>
      <pen interval="1.0" mode="0" display="Dans allée" color="-16776961" legend="true">
        <setup></setup>
        <update>plot passengers-in-plane-count</update>
      </pen>
    </plot>
  </widgets>
  <info><![CDATA[## MODÈLE D'EMBARQUEMENT D'UN AVION COMMERCIAL (NETLOGO)

### Description
Ce modèle multi-agents simule l'embarquement des passagers dans un avion monocouloir commercial (Airbus A320 ou Boeing 737) à partir de plans de cabine réels au format CSV.

### Stratégies d'embarquement implémentées :
1. **Aléatoire (`random`)** : Les passagers embarquent dans un ordre totalement aléatoire. Représente l'embarquement libre / sans consigne.
2. **Avant vers Arrière (`front-to-back`)** : Les passagers des rangées avant (rangée 1, 2, ...) montent en premier, puis ceux de l'arrière.
3. **Arrière vers Avant (`back-to-front`)** : Les passagers du fond de l'appareil montent en premier, puis ceux de l'avant.
4. **WilMA (`wilma`)** : Window-Middle-Aisle. Les passagers aux hublots (A, F) montent en premier, puis les sièges du milieu (B, E), puis les couloirs (C, D).

### Extensibilité :
Le modèle utilise un pattern Stratégie dans `strategies.nls`. Pour ajouter une nouvelle stratégie ultérieurement :
1. Créer le rapporteur de tri dans `strategies.nls` : `to-report strategy-<nom> [ plist ]`
2. Ajouter la condition dans le dispatcher `sort-passengers-by-strategy`
3. Ajouter le nom dans `available-strategies` et dans le widget Chooser.

### Agents Passagers :
Chaque passager possède :
- Un siège cible unique (rangée, lettre, patch physique).
- Un bagage cabine selon la probabilité configurée (`luggage-percentage`).
- Un temps de rangement stochastique (`luggage-stow-time` entre min et max).
- Un état : en attente à la porte, en marche dans l'allée, en rangement, en déplacement vers le siège, assis.

### Échelle :
- 1 patch = 0,5 mètre.
- 1 tick = 1 seconde.
- Vitesse libre dans l'allée = 0,5 m/s (1 patch / tick).
]]></info>
