;; ==============================================================================
;; SIMULATION D'EMBARQUEMENT D'UN AVION COMMERCIAL
;; Module d'initialisation de l'environnement depuis fichiers CSV (A320 & B737)
;; ==============================================================================

;; ------------------------------------------------------------------------------
;; Procédure de chargement de la cabine depuis les fichiers CSV
;; ------------------------------------------------------------------------------
to load-aircraft-environment [ a-type ]
  let grid-filename ""
  let labels-filename ""

  ifelse a-type = "B737" [
    set grid-filename resolve-data-path "B737_cabin.csv"
    set labels-filename resolve-data-path "B737_cabin_labels.csv"
  ] [
    set grid-filename resolve-data-path "A320_cabin.csv"
    set labels-filename resolve-data-path "A320_cabin_labels.csv"
  ]

  ;; Lecture des fichiers CSV
  let raw-grid csv:from-file grid-filename
  let raw-labels csv:from-file labels-filename

  set cabin-length length raw-grid
  set cabin-width length (item 0 raw-grid)

  ;; Redimensionner l'univers NetLogo aux dimensions exactes :
  ;; X : de 0 à (cabin-width - 1) -> 9 colonnes (0 à 8)
  ;; Y : de 0 à (cabin-length - 1) -> avant de l'avion en haut (max-pycor)
  resize-world 0 (cabin-width - 1) 0 (cabin-length - 1)

  ;; Remplissage des cellules depuis les matrices CSV
  let row-idx 0
  foreach raw-grid [ grid-row-data ->
    let labels-row-data item row-idx raw-labels
    let col-idx 0

    ;; En NetLogo, pycor = 0 est en bas et max-pycor est en haut.
    ;; La rangée 0 du CSV (cockpit / avant) est donc placée à max-pycor.
    let y-cor (cabin-length - 1 - row-idx)

    foreach grid-row-data [ cell-value ->
      let label-value item col-idx labels-row-data

      ask patch col-idx y-cor [
        set occupied? false
        set is-exit-row? false
        set is-business? false
        set seat-id ""
        set seat-row 0
        set seat-letter ""

        ;; Décodage du code numérique de la cellule
        (ifelse
          cell-value = 0 [
            set patch-type "wall"
          ]
          cell-value = 1 [
            set patch-type "aisle"
          ]
          cell-value = 2 [
            set patch-type "seat"
            set seat-id (word label-value)

            ;; Extraction de la rangée (chiffres) et de la lettre (dernier caractère)
            if length seat-id >= 2 [
              let last-char last seat-id
              set seat-letter last-char
              let row-str substring seat-id 0 (length seat-id - 1)
              set seat-row read-from-string row-str
            ]

            ;; Identification des sorties de secours et classe affaires
            if a-type = "A320" and (seat-row = 12 or seat-row = 14) [
              set is-exit-row? true
            ]
            if a-type = "B737" [
              if (seat-row = 11 or seat-row = 12) [
                set is-exit-row? true
              ]
              if (seat-row <= 3) [
                set is-business? true
              ]
            ]
          ]
          cell-value = 3 [
            set patch-type "door"
            set door-patch self
          ]
          [
            set patch-type "wall"
          ]
        )
      ]
      set col-idx col-idx + 1
    ]
    set row-idx row-idx + 1
  ]

  ;; Calcul des indicateurs structurels
  set total-seats count patches with [ patch-type = "seat" ]
  set total-seat-rows length remove-duplicates [ seat-row ] of patches with [ patch-type = "seat" ]
end

;; ------------------------------------------------------------------------------
;; Résolution robuste du chemin des fichiers de données
;; ------------------------------------------------------------------------------
to-report resolve-data-path [ filename ]
  if file-exists? filename [ report filename ]
  if file-exists? (word "data/" filename) [ report (word "data/" filename) ]
  if file-exists? (word "../data/" filename) [ report (word "../data/" filename) ]
  error (word "Fichier introuvable : " filename)
end

;; ------------------------------------------------------------------------------
;; Coloration et style visuel de la cabine
;; ------------------------------------------------------------------------------
to update-visuals
  ask patches [
    (ifelse
      patch-type = "wall" [
        set pcolor gray - 1       ;; Fuselage et cloisons : gris foncé
      ]
      patch-type = "aisle" [
        set pcolor black          ;; Allée centrale : noir
      ]
      patch-type = "door" [
        set pcolor green + 1      ;; Porte d'embarquement : vert vif
      ]
      patch-type = "seat" [
        ifelse is-business? [
          set pcolor magenta      ;; Classe Affaires (B737) : magenta
        ] [
          ifelse is-exit-row? [
            set pcolor cyan       ;; Sorties de secours : cyan
          ] [
            set pcolor sky        ;; Classe Éco standard : bleu ciel
          ]
        ]
      ]
      [ set pcolor white ]
    )

    ;; Affichage optionnel des étiquettes (ex: "12A")
    ifelse (is-boolean? show-seat-labels? and show-seat-labels?) and patch-type = "seat" [
      set plabel seat-id
      set plabel-color white
    ] [
      set plabel ""
    ]
  ]
end

;; ------------------------------------------------------------------------------
;; Basculer l'affichage des identifiants de sièges
;; ------------------------------------------------------------------------------
to toggle-labels
  set show-seat-labels? not show-seat-labels?
  update-visuals
end

;; ------------------------------------------------------------------------------
;; Utilitaires / Rapporteurs pour l'environnement et les passagers
;; ------------------------------------------------------------------------------
to-report get-seat [ target-id ]
  report one-of patches with [ seat-id = target-id ]
end

to-report get-aisle-patch-for-seat [ target-id ]
  let target get-seat target-id
  if target = nobody [ report nobody ]
  report patch 4 ([ pycor ] of target)
end

to-report seat-patches
  report patches with [ patch-type = "seat" ]
end

to-report aisle-patches
  report patches with [ patch-type = "aisle" ]
end

;; ------------------------------------------------------------------------------
;; Bilan synthétique dans la console NetLogo
;; ------------------------------------------------------------------------------
to print-cabin-summary
  print "========================================================"
  print (word " Cabine chargée : " aircraft-type)
  print (word " Dimensions     : " cabin-width " colonnes x " cabin-length " rangées")
  print (word " Total sièges   : " total-seats " places")
  print (word " Rangées sièges : " total-seat-rows " rangées distinctes")
  if door-patch != nobody [
    print (word " Porte d'entrée : patch [" [pxcor] of door-patch ", " [pycor] of door-patch "]")
  ]
  print (word " Sièges issues  : " count patches with [ is-exit-row? ])
  if aircraft-type = "B737" [
    print (word " Sièges affaires: " count patches with [ is-business? ])
  ]
  print "========================================================"
end
