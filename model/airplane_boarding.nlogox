  <experiments>
    <experiment name="test-a320-random" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="3000">
      <setup>set aircraft-type "A320"
set boarding-strategy "random"
set occupancy-rate 100
set luggage-percentage 80
set min-luggage-delay 5
set max-luggage-delay 15
setup</setup>
      <go>go</go>
      <metrics>
        <metric>ticks</metric>
        <metric>passengers-seated-count</metric>
        <metric>total-interference-ticks</metric>
        <metric>mean-passenger-wait-time</metric>
